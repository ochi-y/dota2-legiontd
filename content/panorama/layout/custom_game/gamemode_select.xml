<root>
    <styles>
        <include src="s2r://panorama/styles/dotastyles.vcss_c" />
        <include src="s2r://panorama/styles/custom_game/gamemode_select.css" />
    </styles>
    <scripts>
        <include src="s2r://panorama/scripts/custom_game/gamemode_select.js" />
    </scripts>
    <snippets>
        <snippet name="ChooseItem">
            <Panel  class="itemButton">
                <Label text="{s:itemName}" class="itemName" />
            </Panel>
        </snippet>
        <snippet name="ChooseHero">
            <Panel  class="itemButtonHero" >
                <!-- <Label text="{s:itemName}" class="itemName" /> -->
                <DOTAScenePanel class="heroPanel" id="heroPanel" style="width:150px;height:180px;" unit="npc_dota_hero_tusk" particleonly='false' rotateonhover='true' yawmin='-10' yawmax='10' pitchmin='-5' pitchmax='5'/>
                <!-- <Label text="{s:itemName}" class="HeroItemName" /> -->
            </Panel>
        </snippet>

        <snippet name="ChooseHeroSingle">
            <Panel  class="itemButtonHeroSingle" > 
                <!-- <Label text="{s:itemName}" class="itemName" /> -->
                <DOTAScenePanel class="heroPanel" id="heroPanel" style="width:340px;height:360px;" unit="npc_dota_hero_tusk" particleonly='false' rotateonhover='true' yawmin='-10' yawmax='10' pitchmin='-5' pitchmax='5'/>
                <!-- <Label text="{s:itemName}" class="HeroItemName" /> -->
            </Panel>
        </snippet>
    </snippets>
    <Panel hittest="false" class="CustomHudRoot" onactivate="" >
        <Panel class="mainContainer" id="mainContainer" onactivate="">
            <Label  text="{s:title}" class="title"/>
            <Panel class="items" id="items">
            </Panel>
        </Panel>
    </Panel>
</root>