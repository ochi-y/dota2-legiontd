        <snippet name="KingAbilityCard">
            <Panel class="KingAbilityCard">
                <Panel  class="KingAbilityName">
                    <Label class="" text="{s:ability_name}" />
                </Panel>
                <Panel class="KingAbilityCardSub">
                    <DOTAAbilityImage class="KingAbilityImage" id="AbilityImage" abilityname="orc_pulverize" showtooltip="true"/>
