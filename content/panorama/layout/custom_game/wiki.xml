                </Panel>
            </Panel>
        </snippet>
        <snippet name="AbilityItem">
            <Panel class="AbilityItem">
                <DOTAAbilityImage class="" id="AbilityItem_abilityImage" abilityname="orc_pulverize" showtooltip="false"/>
