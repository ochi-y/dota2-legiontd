<root>
    <styles>
        <include src="s2r://panorama/styles/dotastyles.vcss_c" />
        <include src="s2r://panorama/layout/custom_game/profile/profile.css" />
    </styles>
    <scripts>
        <include src="s2r://panorama/layout/custom_game/profile/profile.js" />
    </scripts>
    <snippets>
        <snippet name="snippet_fighter">
            <Panel  class="fighterPanel">

                <Label  class="fighterLabel" text="{s:count}" />
                <DOTAScenePanel class="fighter" id="fighter" unit="npc_dota_hero_tusk" particleonly='false' rotateonhover='true' yawmin='-10' yawmax='10' pitchmin='-5' pitchmax='5'/>
            </Panel>
        </snippet>
        <snippet name="snippet_match">
            <Panel class="match">
                <Panel class="playerCol col1 playerCol1">
                    <Label  text="{s:date}" />
                </Panel>
                <Panel id="fighterList" class="playerCol col2 playerCol2">
                    <Label  class="fighterLabel" text="--" />
                </Panel>
                <Panel class="playerCol col3 playerCol3">
                    <Label id="resultLabel" class="" text="{s:result}" />
                </Panel>
                <Panel class="playerCol col4 playerCol4">
                    <Label  text="{s:elo}" />
                </Panel>
                <Panel class="playerCol col5 playerCol5">
                    <Label  text="{s:duration}" />
                </Panel>
                <Panel class="playerCol col6 playerCol6">
                    <Label  text="{s:mode}" />
                </Panel>
            </Panel>
        </snippet>
    </snippets>
    <Panel class="root"  hittest="false" >
        <Panel id="leaderboardRoot" class="leaderboardRoot Hidden" hittest="true">
            <Panel  class="bg"></Panel>
            <Panel class="container">
                <Button id="closeBtn" onactivate="onCloseBtn();" />
                <Panel class="container1">
                    <Panel class="header">
                        <Panel  class="title">
                            <Label id="titleLabel" class="" text="{s:title}" />
                        </Panel>
                        <Panel  class="subTitle">
                            <Panel  class="kv">
                                <Label  class="kvKey" text="#ui_elo" />
                                <Label  class="kvValue" text="{s:player_elo}" />
                            </Panel>
                            <Panel  class="kv">
                                <Label  class="kvKey" text="#ui_all_matchs" />
                                <Label  class="kvValue" text="{s:player_match_count}" />
                            </Panel>
                            <Panel  class="kv">
                                <Label  class="kvKey" text="#ui_winrate" />
                                <Label  class="kvValue" text="{s:player_winrate}" />
                            </Panel>
                        </Panel>
                    </Panel>
                    <Panel  class="content">

                        <Panel  class="bg1"></Panel>

                        <Panel  class="contentHeader">
                            <Label class="col col1" text="#ui_date" />
                            <Label class="col col2" text="#ui_fighters" />
                            <Label class="col col3" text="#ui_result" />
                            <Label class="col col4" text="#ui_elo" />
                            <Label class="col col5" text="#ui_duration" />
                            <Label class="col col6" text="#ui_mode" />
                        </Panel>
                        <Panel id="matchListContainer" class="">

                            <Panel id="matchList" class="">
                            
                            </Panel>
                            <Button  class="loadBtn" onactivate="OnClickLoad();">
                                <Label  class="" text="{s:load_btn}" />
                            </Button>
                            
                        </Panel>
                    </Panel>
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>